# The registration and admin pages' headers, as the Worker's static assets serve them (discord-community-lobby):
# no framing (the admin page can't be clickjacked), scripts and calls from this origin only, no referrer.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; img-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'
